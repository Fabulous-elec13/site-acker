---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandeauCookies from '../components/BandeauCookies.astro';
import { entreprise } from '../data/entreprise.js';

const {
  titre,
  description = `${entreprise.nom} : électricité générale, dépannage, rénovation résidentielle et commerciale, mise aux normes et mise en valeur des matières par l'éclairage à Marseille et alentours.`,
} = Astro.props;

const titreComplet = titre ? `${titre} · ${entreprise.nom}` : `${entreprise.nom} · Électricien à Marseille et alentours`;
const canonique = new URL(Astro.url.pathname, Astro.site);

const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: entreprise.nom,
  founder: entreprise.dirigeant,
  telephone: entreprise.telephoneLien,
  taxID: entreprise.siret,
  url: Astro.site?.toString(),
  image: new URL('/og-image.jpg', Astro.site).toString(),
  logo: new URL('/icon-512.png', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: entreprise.adresse.rue,
    postalCode: entreprise.adresse.codePostal,
    addressLocality: entreprise.adresse.ville,
    addressCountry: 'FR',
  },
  areaServed: entreprise.zone,
  openingHours: 'Mo-Fr 08:00-18:00',
  sameAs: [entreprise.instagram],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050608" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:site_name" content={entreprise.nom} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BandeauCookies />
  </body>
</html>
